{
    "name": "kipchak/driver-http",
    "type": "middleware",
    "description": "An HTTP Kipchak driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Mamluk\\Kipchak\\Driver\\Http\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/http": "^12.40",
        "mamluk/kipchak": "2.x-dev"
    }
}
