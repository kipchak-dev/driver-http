{
    "name": "kipchak/driver-http",
    "type": "middleware",
    "description": "An HTTP Kipchak driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Http\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/http": "^13.0",
        "kipchak/core": "^2 || ^3",
        "psr/http-client": "^1"
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\Http\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "kipchak/driver-config": "Named clients from config/kipchak.http.php; without it, Http::get() returns Laravel's client as before"
    },
    "require-dev": {
        "http-interop/http-factory-tests": "^2.4",
        "kipchak/driver-config": "^1",
        "php-http/client-integration-tests": "^4.1",
        "phpunit/phpunit": "^12"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.http.php",
            "initialise": "\\Kipchak\\Driver\\Http\\Http::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-http"
        }
    }
}
